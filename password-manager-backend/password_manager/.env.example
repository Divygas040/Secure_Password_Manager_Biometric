DJANGO_SECRET_KEY=<private-random-django-secret>
DEBUG=<True-for-local-development-False-for-production>
ALLOWED_HOSTS=<comma-separated-api-hosts>
CORS_ALLOWED_ORIGINS=<comma-separated-frontend-origins>
CSRF_TRUSTED_ORIGINS=<comma-separated-frontend-origins>
DATABASE_URL=<private-postgresql-connection-url-or-empty-for-local-sqlite>
EMAIL_BACKEND=<django-email-backend-class>
EMAIL_HOST=<smtp-host>
EMAIL_PORT=<smtp-port>
EMAIL_USE_TLS=<True-or-False>
EMAIL_USE_SSL=<True-or-False>
EMAIL_HOST_USER=<smtp-username>
EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=<verified-sender-address>
VAULT_ENCRYPTION_KEY=<private-fernet-key>
BIOMETRIC_ENCRYPTION_KEY=<different-private-fernet-key>
COOKIE_SAMESITE=<Lax-or-None-for-cross-site-HTTPS-preview>
TRUST_PROXY_HTTPS=<True-only-behind-trusted-HTTPS-proxy>
TRUSTED_PROXY_COUNT=<trusted-proxy-count-or-zero>
SECURE_HSTS_SECONDS=<zero-until-HTTPS-verified>
